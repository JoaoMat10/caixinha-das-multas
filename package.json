{
  "name": "caixinha-das-multas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/validate-cloudflare-production-env.mjs && tsc -b && vite build && node scripts/finalize-pages-build.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:pages": "node --test tests/pages/*.test.mjs",
    "test:db": "node --test tests/database/*.test.mjs",
    "test:db:supabase": "node scripts/test-supabase-linked.mjs",
    "test:db:supabase:local": "supabase db reset --local && supabase test db --local",
    "test:auth:supabase": "node scripts/test-auth-supabase.mjs",
    "test:admin:supabase": "node scripts/test-admin-supabase.mjs",
    "test:concurrency:supabase": "node scripts/test-concurrency-supabase.mjs",
    "test:watch": "vitest",
    "populate:production": "node scripts/populate-production-roster.mjs",
    "populate:production:catalog": "node scripts/populate-production-fine-catalog.mjs",
    "populate:production:august-fines": "node scripts/import-production-august-fines.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc -b",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:db && npm run build && npm run test:pages"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.102.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.142.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
