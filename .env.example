# Apenas variaveis publicas com o prefixo VITE_ podem ser usadas no frontend.
# Nunca colocar chaves secretas, tokens administrativos ou credenciais neste ficheiro.
VITE_APP_NAME=Caixinha das Multas
VITE_PUBLIC_APP_URL=http://127.0.0.1:5173
VITE_SUPABASE_URL=https://project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substituir

# Proteção dos testes remotos; usar apenas a referência de um projeto descartável.
# Esta variável não chega ao frontend por não ter o prefixo VITE_.
SUPABASE_TEST_PROJECT_REF=project-ref-de-testes
